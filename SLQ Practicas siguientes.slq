¡Claro que sí! Aquí tienes los dos ejemplos ampliados. He añadido **10 registros** (datos) para cada tabla y he colocado un comentario (`--`) explicando **línea por línea** exactamente qué hace cada instrucción de código. 

### Ejemplo 1: Plataforma de Cine (Directores, Películas y Actores)

```sql
-- 1. CREACIÓN DE LA ESTRUCTURA (TABLAS) PARA EL CINE

CREATE TABLE Directores ( -- Crea una nueva tabla llamada 'Directores' en la base de datos.
    DirectorID INT AUTO_INCREMENT PRIMARY KEY, -- Crea una columna de números enteros (INT) que sube de 1 en 1 automáticamente, siendo el identificador único.
    Nombre VARCHAR(100) NOT NULL, -- Crea una columna de texto ('Nombre') de hasta 100 letras; 'NOT NULL' exige que siempre se llene este dato.
    Nacionalidad VARCHAR(50), -- Crea una columna de texto ('Nacionalidad') de hasta 50 letras para el país de origen (opcional).
    FechaNacimiento DATE -- Crea una columna ('FechaNacimiento') especializada en guardar fechas (Año-Mes-Día).
); -- Cierra la instrucción de creación de la tabla 'Directores'.

CREATE TABLE Actores ( -- Crea una nueva tabla llamada 'Actores'.
    ActorID INT AUTO_INCREMENT PRIMARY KEY, -- Crea el identificador numérico único y automático para cada actor.
    Nombre VARCHAR(100) NOT NULL, -- Crea la columna para el nombre del actor, obligatoria y de hasta 100 caracteres.
    PremioOscar BOOLEAN DEFAULT FALSE -- Crea una columna de verdadero/falso (BOOLEAN) para saber si tiene un Oscar; por defecto es Falso.
); -- Cierra la instrucción de creación de la tabla 'Actores'.

CREATE TABLE Peliculas ( -- Crea una nueva tabla llamada 'Peliculas'.
    PeliculaID INT AUTO_INCREMENT PRIMARY KEY, -- Crea el identificador numérico único y automático para cada película.
    Titulo VARCHAR(150) NOT NULL, -- Crea una columna para el título de la película, obligatoria, de hasta 150 caracteres.
    AnioLanzamiento YEAR, -- Crea una columna para almacenar específicamente un año (como 1994 o 2001).
    DirectorID INT, -- Crea una columna numérica que guardará el ID del director que hizo esta película.
    FOREIGN KEY (DirectorID) REFERENCES Directores(DirectorID) -- Declara que 'DirectorID' es una Clave Foránea que apunta y exige que exista ese ID en la tabla 'Directores'.
); -- Cierra la instrucción de creación de la tabla 'Peliculas'.

CREATE TABLE PeliculaActor ( -- Crea la tabla puente o intermedia para conectar múltiples actores con múltiples películas.
    PeliculaID INT, -- Crea una columna para guardar el ID de la película.
    ActorID INT, -- Crea una columna para guardar el ID del actor que actúa en esa película.
    Personaje VARCHAR(100), -- Crea una columna de texto para anotar qué personaje histórico o ficticio interpretó el actor.
    FOREIGN KEY (PeliculaID) REFERENCES Peliculas(PeliculaID), -- Obliga a que el 'PeliculaID' exista previamente en la tabla 'Peliculas'.
    FOREIGN KEY (ActorID) REFERENCES Actores(ActorID), -- Obliga a que el 'ActorID' exista previamente en la tabla 'Actores'.
    PRIMARY KEY (PeliculaID, ActorID) -- Define que la combinación de Película+Actor no se puede repetir (un actor no puede actuar dos veces igual en la misma película).
); -- Cierra la instrucción de creación de la tabla puente.

-- 2. INSERCIÓN DE 10 DATOS EN CADA TABLA

-- Insertamos 10 directores emblemáticos
INSERT INTO Directores (Nombre, Nacionalidad, FechaNacimiento) VALUES -- Instrucción para añadir múltiples filas a la tabla 'Directores'.
    ('Christopher Nolan', 'Británica', '1970-07-30'), -- Inserta el director 1 con sus respectivos datos.
    ('Quentin Tarantino', 'Estadounidense', '1963-03-27'), -- Inserta el director 2.
    ('Martin Scorsese', 'Estadounidense', '1942-11-17'), -- Inserta el director 3.
    ('Steven Spielberg', 'Estadounidense', '1946-12-18'), -- Inserta el director 4.
    ('Francis Ford Coppola', 'Estadounidense', '1939-04-07'), -- Inserta el director 5.
    ('Stanley Kubrick', 'Estadounidense', '1928-07-26'), -- Inserta el director 6.
    ('Alfred Hitchcock', 'Británica', '1899-08-13'), -- Inserta el director 7.
    ('James Cameron', 'Canadiense', '1954-08-16'), -- Inserta el director 8.
    ('Peter Jackson', 'Neozelandesa', '1961-10-31'), -- Inserta el director 9.
    ('David Fincher', 'Estadounidense', '1962-08-28'); -- Inserta el director 10 y finaliza con el punto y coma.

-- Insertamos 10 actores legendarios
INSERT INTO Actores (Nombre, PremioOscar) VALUES -- Instrucción para añadir múltiples filas a la tabla 'Actores'.
    ('Leonardo DiCaprio', TRUE), -- Inserta al actor 1 y marca que SÍ tiene un premio Oscar (TRUE).
    ('Brad Pitt', TRUE), -- Inserta al actor 2.
    ('Robert De Niro', TRUE), -- Inserta al actor 3.
    ('Tom Hanks', TRUE), -- Inserta al actor 4.
    ('Al Pacino', TRUE), -- Inserta al actor 5.
    ('Jack Nicholson', TRUE), -- Inserta al actor 6.
    ('Marlon Brando', TRUE), -- Inserta al actor 7.
    ('Morgan Freeman', TRUE), -- Inserta al actor 8.
    ('Christian Bale', TRUE), -- Inserta al actor 9.
    ('Samuel L. Jackson', FALSE); -- Inserta al actor 10 indicando que NO tiene un Oscar (FALSE).

-- Insertamos 10 películas famosas asignándolas a sus directores
INSERT INTO Peliculas (Titulo, AnioLanzamiento, DirectorID) VALUES -- Instrucción para añadir filas a la tabla 'Peliculas'.
    ('Inception', 2010, 1), -- Inserta la película 1 y la asigna al Director 1 (Nolan).
    ('Pulp Fiction', 1994, 2), -- Inserta la película 2 y la asigna al Director 2 (Tarantino).
    ('Goodfellas', 1990, 3), -- Inserta la película 3 y la asigna al Director 3 (Scorsese).
    ('Jurassic Park', 1993, 4), -- Inserta la película 4 y la asigna al Director 4 (Spielberg).
    ('The Godfather', 1972, 5), -- Inserta la película 5 y la asigna al Director 5 (Coppola).
    ('The Shining', 1980, 6), -- Inserta la película 6 y la asigna al Director 6 (Kubrick).
    ('Psycho', 1960, 7), -- Inserta la película 7 y la asigna al Director 7 (Hitchcock).
    ('Titanic', 1997, 8), -- Inserta la película 8 y la asigna al Director 8 (Cameron).
    ('The Lord of the Rings', 2001, 9), -- Inserta la película 9 y la asigna al Director 9 (Jackson).
    ('Fight Club', 1999, 10); -- Inserta la película 10 y la asigna al Director 10 (Fincher).

-- Insertamos 10 relaciones (Qué actor sale en qué película y cuál es su rol)
INSERT INTO PeliculaActor (PeliculaID, ActorID, Personaje) VALUES -- Instrucción para añadir filas a la tabla puente 'PeliculaActor'.
    (1, 1, 'Cobb'), -- Vincula a la Película 1 ('Inception') con el Actor 1 ('DiCaprio') bajo el rol de 'Cobb'.
    (2, 10, 'Jules Winnfield'), -- Vincula Película 2 ('Pulp Fiction') con Actor 10 ('Samuel L. Jackson').
    (3, 3, 'Jimmy Conway'), -- Vincula Película 3 ('Goodfellas') con Actor 3 ('De Niro').
    (4, 10, 'Ray Arnold'), -- Vincula Película 4 ('Jurassic Park') con Actor 10 ('Samuel L. Jackson').
    (5, 5, 'Michael Corleone'), -- Vincula Película 5 ('The Godfather') con Actor 5 ('Pacino').
    (5, 7, 'Vito Corleone'), -- Vincula Película 5 ('The Godfather') con Actor 7 ('Brando'); dos actores en la misma peli.
    (6, 6, 'Jack Torrance'), -- Vincula Película 6 ('The Shining') con Actor 6 ('Nicholson').
    (8, 1, 'Jack Dawson'), -- Vincula Película 8 ('Titanic') con Actor 1 ('DiCaprio').
    (10, 2, 'Tyler Durden'), -- Vincula Película 10 ('Fight Club') con Actor 2 ('Pitt').
    (1, 2, 'Colaborador Ficticio'); -- Agregamos una relación extra ficticia (Actor 2 en Película 1) para sumar los 10 registros.
```

