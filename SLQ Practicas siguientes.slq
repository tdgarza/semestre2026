### Ejemplo 2: Sistema Escolar (Profesores, Cursos y Estudiantes)

```sql
-- 1. CREACIÓN DE LA ESTRUCTURA (TABLAS) PARA LA ESCUELA

CREATE TABLE Profesores ( -- Inicia la creación de la tabla para almacenar la plantilla de profesores.
    ProfesorID INT AUTO_INCREMENT PRIMARY KEY, -- Define un número automático, incrementable e irrepetible como código del profesor.
    Nombre VARCHAR(100) NOT NULL, -- Define una columna obligatoria para guardar el nombre completo del profesor (hasta 100 caracteres).
    Especialidad VARCHAR(100) -- Define una columna opcional para detallar la rama de conocimiento del profesor (hasta 100 caracteres).
); -- Finaliza la creación de la tabla de profesores.

CREATE TABLE Estudiantes ( -- Inicia la creación de la tabla que registrará a todos los alumnos inscritos.
    EstudianteID INT AUTO_INCREMENT PRIMARY KEY, -- Define la matrícula única como un número que suma de uno en uno, siendo clave primaria.
    Nombre VARCHAR(100) NOT NULL, -- Define el campo de nombre del estudiante como obligatorio y de máximo 100 letras.
    AnioIngreso YEAR -- Define una columna exclusiva para guardar el año en el que el estudiante comenzó sus estudios.
); -- Finaliza la creación de la tabla de estudiantes.

CREATE TABLE Cursos ( -- Inicia la creación de la tabla que cataloga todas las materias o asignaturas impartidas.
    CursoID INT AUTO_INCREMENT PRIMARY KEY, -- Asigna un código numérico único e inalterable para cada materia creada.
    NombreCurso VARCHAR(100) NOT NULL, -- Define el nombre de la materia como un campo de texto restringido a 100 letras y obligatorio.
    Creditos INT, -- Define una columna numérica entera para el valor en créditos o peso académico del curso.
    ProfesorID INT, -- Define una columna numérica que guardará apuntada la referencia del profesor que dicta la materia.
    FOREIGN KEY (ProfesorID) REFERENCES Profesores(ProfesorID) -- Instruye a la base de datos que este número debe existir sí o sí en la tabla 'Profesores'.
); -- Finaliza la creación de la tabla de materias/cursos.

CREATE TABLE Inscripciones ( -- Crea la tabla puente o auxiliar, ya que los estudiantes toman varios cursos y los cursos tienen muchos estudiantes.
    InscripcionID INT AUTO_INCREMENT PRIMARY KEY, -- Crea un número de ticket o recibo de inscripción individual para cada registro generado.
    EstudianteID INT, -- Guarda de manera cruzada la matrícula del estudiante que se va a relacionar.
    CursoID INT, -- Guarda de manera cruzada el código del curso donde el estudiante se va a registrar.
    FechaInscripcion DATE, -- Guarda exactamente el día en que se hizo el registro (Año-mes-día).
    CalificacionFinal DECIMAL(3,1), -- Guarda un número con decimales (Ej. 9.5) para asentar la nota final al terminar el semestre.
    FOREIGN KEY (EstudianteID) REFERENCES Estudiantes(EstudianteID), -- Protege la integridad exigiendo que el estudiante sea real y exista en la otra tabla.
    FOREIGN KEY (CursoID) REFERENCES Cursos(CursoID) -- Protege la integridad validando que el curso sí sea un registro válido.
); -- Finaliza la instrucción para crear esta tabla de cruce de datos.

-- 2. INSERCIÓN DE 10 DATOS EN CADA TABLA

-- Insertamos 10 Profesores (Científicos históricos repensados como maestros)
INSERT INTO Profesores (Nombre, Especialidad) VALUES -- Instruye motor SQL para introducir 10 registros nuevos sobre maestros.
    ('Alan Turing', 'Programación Avanzada'), -- Inserta el profesor 1 y su área experta.
    ('Marie Curie', 'Física Cuántica'), -- Inserta la profesora 2.
    ('Albert Einstein', 'Relatividad y Física'), -- Inserta el profesor 3.
    ('Isaac Newton', 'Cálculo y Mecánica'), -- Inserta el profesor 4.
    ('Nikola Tesla', 'Ingeniería Eléctrica'), -- Inserta el profesor 5.
    ('Charles Darwin', 'Biología Evolutiva'), -- Inserta el profesor 6.
    ('Ada Lovelace', 'Algoritmos'), -- Inserta la profesora 7.
    ('Carl Sagan', 'Astronomía'), -- Inserta el profesor 8.
    ('Luis Pasteur', 'Microbiología'), -- Inserta el profesor 9.
    ('Galileo Galilei', 'Astronomía Clásica'); -- Inserta el profesor 10 y cierra el bloque de inserción.

-- Insertamos 10 Estudiantes ficticios
INSERT INTO Estudiantes (Nombre, AnioIngreso) VALUES -- Instruye introducir múltiples alumnos.
    ('Ana Sophia Martínez', 2021), -- Carga los datos de la estudiante 1 y el año de entrada.
    ('Carlos Ruiz', 2022), -- Carga los datos del estudiante 2.
    ('María Fernández', 2023), -- Carga los datos de la estudiante 3.
    ('Jorge Salinas', 2021), -- Carga los datos del estudiante 4.
    ('Lucía Pineda', 2023), -- Carga los datos de la estudiante 5.
    ('Miguel Torres', 2020), -- Carga los datos del estudiante 6.
    ('Valentina Reyes', 2022), -- Carga los datos de la estudiante 7.
    ('David Ochoa', 2021), -- Carga los datos del estudiante 8.
    ('Fernanda Gil', 2023), -- Carga los datos de la estudiante 9.
    ('Ricardo Gomez', 2021); -- Carga los datos del estudiante 10 y cierra el bloque de alumnos.

-- Insertamos 10 Cursos diferentes vinculados a un profesor
INSERT INTO Cursos (NombreCurso, Creditos, ProfesorID) VALUES -- Abre el comando para añadir clases.
    ('Lógica de Sistemas', 8, 1), -- Asigna la clase 1 (8 créditos) al Profesor 1 (Turing).
    ('Física I', 6, 4), -- Asigna la clase 2 (6 créditos) al Profesor 4 (Newton).
    ('Circuitos', 7, 5), -- Asigna la clase 3 (7 créditos) al Profesor 5 (Tesla).
    ('Astrofísica Aplicada', 9, 8), -- Asigna la clase 4 al Profesor 8.
    ('Física II', 8, 3), -- Asigna la clase 5 al Profesor 3.
    ('Biología Celular', 6, 6), -- Asigna la clase 6 al Profesor 6.
    ('Laboratorio Químico', 7, 2), -- Asigna la clase 7 a la Profesora 2.
    ('Algoritmia', 9, 7), -- Asigna la clase 8 a la Profesora 7.
    ('Bacteriología', 6, 9), -- Asigna la clase 9 al Profesor 9.
    ('Observación Espacial', 5, 10); -- Asigna la clase 10 al Profesor 10 y finaliza proceso.

-- Insertamos 10 Inscripciones haciendo cruces matriculares 
INSERT INTO Inscripciones (EstudianteID, CursoID, FechaInscripcion, CalificacionFinal) VALUES -- Instructivo para cargar el expediente de los alumnos.
    (1, 1, '2023-08-01', 9.5), -- Estudiante 1 cursa Clase 1, inscrito tal fecha y saco de nota 9.5.
    (2, 2, '2023-08-02', 8.0), -- Estudiante 2 cursa Clase 2 con nota final 8.0.
    (3, 3, '2023-08-03', NULL), -- Estudiante 3 cursa Clase 3, aún sin nota (NULL significa dato vacío o en curso).
    (4, 4, '2023-08-04', 10.0), -- Estudiante 4 cursa Clase 4 de Astrofísica, saca calificación perfecta.
    (5, 5, '2023-08-05', 7.5), -- Estudiante 5 cursa Clase 5, calificación regular.
    (6, 6, '2023-08-06', NULL), -- Estudiante 6 cursa Clase 6, curso pendiente.
    (7, 7, '2023-08-07', 9.0), -- Estudiante 7 cursa Clase 7 con buena nota de 9.0.
    (8, 8, '2023-08-08', 8.5), -- Estudiante 8 está tomado Programación.
    (9, 9, '2023-08-09', NULL), -- Estudiante 9 sigue en curso de Bacteriología.
    (10, 10, '2023-08-10', 9.8); -- Estudiante 10 curza observación espacial con nota 9.8 y se termina de cargar.
```

Espero que con estos comentarios exhaustivos cada elemento del código SQL sea más fácil de interpretar de principio a fin. ¡Dime si quieres que profundicemos en alguna línea específica!